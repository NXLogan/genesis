# === Discord ===
# Token du bot (Discord Developer Portal > Bot > Token)
DISCORD_TOKEN=
# ID de l'application (Developer Portal > General Information > Application ID)
DISCORD_CLIENT_ID=
# Secret OAuth2 (Developer Portal > OAuth2 > Client Secret)
DISCORD_CLIENT_SECRET=
# ID de ton serveur Discord (clic droit sur le serveur > Copier l'identifiant)
GUILD_ID=

# === Panel Web ===
# Port du panel web
PORT=3000
# URL publique du panel (utilisée pour le callback OAuth2)
PANEL_URL=http://localhost:3000
# Secret de session (mets une longue chaîne aléatoire)
SESSION_SECRET=change-moi-avec-une-chaine-aleatoire

# === Lavalink (musique) ===
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass

# === GitHub → Discord (logs de commits) ===
# Secret partagé avec le webhook GitHub (Settings > Webhooks) ou le secret Actions
# Génère-en un : openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

